{
	"info": {
		"_postman_id": "c1f8e12b-4b13-4a1d-8b01-789a5c8e2d4f",
		"name": "ZooLearn Supabase Auth",
		"description": "A collection to test ZooLearn's Supabase Authentication endpoints directly via the Supabase REST API.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "1. Sign Up (Create Account)",
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "apikey",
						"value": "{{supabase_anon_key}}",
						"type": "text"
					},
					{
						"key": "Content-Type",
						"value": "application/json",
						"type": "text"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\r\n    \"email\": \"test@example.com\",\r\n    \"password\": \"SecurePass123!\"\r\n}"
				},
				"url": {
					"raw": "{{supabase_url}}/auth/v1/signup",
					"host": [
						"{{supabase_url}}"
					],
					"path": [
						"auth",
						"v1",
						"signup"
					]
				}
			},
			"response": []
		},
		{
			"name": "2. Sign In (Login)",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"var jsonData = pm.response.json();",
							"if(jsonData.access_token) {",
							"    pm.environment.set(\"supabase_access_token\", jsonData.access_token);",
							"}"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "apikey",
						"value": "{{supabase_anon_key}}",
						"type": "text"
					},
					{
						"key": "Content-Type",
						"value": "application/json",
						"type": "text"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\r\n    \"email\": \"test@example.com\",\r\n    \"password\": \"SecurePass123!\"\r\n}"
				},
				"url": {
					"raw": "{{supabase_url}}/auth/v1/token?grant_type=password",
					"host": [
						"{{supabase_url}}"
					],
					"path": [
						"auth",
						"v1",
						"token"
					],
					"query": [
						{
							"key": "grant_type",
							"value": "password"
						}
					]
				}
			},
			"response": []
		},
		{
			"name": "3. Get User Profile",
			"request": {
				"method": "GET",
				"header": [
					{
						"key": "apikey",
						"value": "{{supabase_anon_key}}",
						"type": "text"
					},
					{
						"key": "Authorization",
						"value": "Bearer {{supabase_access_token}}",
						"type": "text"
					}
				],
				"url": {
					"raw": "{{supabase_url}}/auth/v1/user",
					"host": [
						"{{supabase_url}}"
					],
					"path": [
						"auth",
						"v1",
						"user"
					]
				}
			},
			"response": []
		},
		{
			"name": "4. Reset Password (Send Email)",
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "apikey",
						"value": "{{supabase_anon_key}}",
						"type": "text"
					},
					{
						"key": "Content-Type",
						"value": "application/json",
						"type": "text"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\r\n    \"email\": \"test@example.com\"\r\n}"
				},
				"url": {
					"raw": "{{supabase_url}}/auth/v1/recover",
					"host": [
						"{{supabase_url}}"
					],
					"path": [
						"auth",
						"v1",
						"recover"
					]
				}
			},
			"response": []
		}
	],
	"variable": [
		{
			"key": "supabase_url",
			"value": "https://oczegyvadkjjplwdsbko.supabase.co"
		},
