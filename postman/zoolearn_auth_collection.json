			"key": "supabase_anon_key",
			"value": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Im9jemVneXZhZGtqanBsd2RzYmtvIiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODM4NDYyMTYsImV4cCI6MjA5OTQyMjIxNn0.09JNTUy15o-Ku8kA2zi1duz6dhcSGPDNG1YDslVRjCM"
		},
		{
			"key": "supabase_access_token",
			"value": ""
		}
	]
}
